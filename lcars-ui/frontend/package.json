{
  "name": "lcars-ui-frontend",
  "version": "6.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "contracts:check": "node scripts/generate-contract.mjs --check && node scripts/generate-workspace-contract.mjs --check",
    "contracts:generate": "node scripts/generate-contract.mjs && node scripts/generate-workspace-contract.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.thresholds.lines=60",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource/antonio": "^5.2.6",
    "@fontsource/rajdhani": "^5.3.0",
    "@tanstack/react-query": "^5.62.7",
    "@tanstack/react-table": "^8.21.3",
    "@xyflow/react": "^12.11.2",
    "ajv": "^8.20.0",
    "axios": "^1.7.7",
    "clsx": "^2.1.1",
    "dompurify": "^3.3.2",
    "hls.js": "^1.6.16",
    "lightweight-charts": "^5.2.0",
    "marked": "^17.0.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.4",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.1",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "^10.4.20",
    "jsdom": "^27.0.1",
    "json-schema-to-typescript": "^15.0.4",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
